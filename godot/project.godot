; Gravity Tales（Godot 版）
; ブラウザ版（../index.html）と同じ大きさ 900×480 の画面で作る。ウィンドウを広げると、そのまま拡大される。

config_version=5

[application]

config/name="Gravity Tales"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=900
window/size/viewport_height=480
window/size/window_width_override=1350
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.94, 0.91, 0.85, 1)

[input]

